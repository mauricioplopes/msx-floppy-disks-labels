10 REM *** ETIQUETAS 3x6 - MSX BASIC ***
20 REM     HotBit MSX - Epson LX-300
25 REM     Autor: Mauricio lopes - https://github.com/mauricioplopes
30 SCREEN 0:WIDTH 40:COLOR 15,1,1:CLS
35 CLEAR 4000
40 REM === CONSTANTES DE LAYOUT ===
50 LW=25:LH=11:ML=3:NT=18:CM=3:GC=1:TM=2
60 DIM LB$(18,3):DIM PM$(18)
70 FOR I=1 TO NT:PM$(I)="S":NEXT I
80 FOR I=1 TO NT:FOR J=1 TO ML:LB$(I,J)="":NEXT J:NEXT I
90 REM
100 REM === LW=chars/etiq  LH=linhas/etiq ===
110 REM === ML=linhas texto NT=num etiquetas ===
120 REM === CM=marg.esq.  GC=gap cols TM=topo ===
130 REM
140 REM ===========================
150 REM       MENU PRINCIPAL
160 REM ===========================
170 CLS
180 PRINT "=========================="
190 PRINT "   IMPRESSAO ETIQUETAS    "
200 PRINT "    3x6 - A4 - LX-300    "
210 PRINT "=========================="
220 PRINT
230 GOSUB 500
240 PRINT
250 PRINT "[1] EDITAR ETIQUETA"
260 PRINT "[2] COPIAR ETIQUETA"
270 PRINT "[3] LIMPAR ETIQUETA"
280 PRINT "[4] LIMPAR TODAS"
290 PRINT "[5] IMPRIMIR"
300 PRINT "[6] SAIR"
310 PRINT
320 PRINT "OPCAO: ";
330 A$=INPUT$(1):PRINT A$
340 IF A$="1" THEN GOSUB 600:GOTO 170
350 IF A$="2" THEN GOSUB 800:GOTO 170
360 IF A$="3" THEN GOSUB 960:GOTO 170
370 IF A$="4" THEN GOSUB 1080:GOTO 170
380 IF A$="5" THEN GOSUB 1200:GOTO 170
390 IF A$="6" THEN PRINT:PRINT "FIM.":END
400 GOTO 320
410 REM
420 REM
430 REM
440 REM
450 REM
460 REM
470 REM
480 REM
490 REM
500 REM ===========================
510 REM    SUB: LISTA ETIQUETAS
520 REM ===========================
530 FOR I=1 TO NT
540 ST$=LEFT$(LB$(I,1),14)
542 IF LB$(I,1)="" THEN ST$="--VAZIA--"
550 NS$=STR$(I):IF LEN(NS$)<3 THEN NS$=" "+NS$
560 PRINT NS$;") ";ST$
570 NEXT I
580 RETURN
590 REM
600 REM ===========================
610 REM    SUB: EDITAR
620 REM ===========================
630 CLS
640 PRINT "EDITAR ETIQUETA"
650 PRINT "Numero (1-18): ";
660 INPUT NE
670 IF NE<1 OR NE>18 THEN RETURN
680 PRINT
690 PRINT "ETIQUETA #";NE
700 PRINT "Max ";LW;" chars por linha."
710 PRINT "ENTER = manter texto atual."
720 PRINT
730 FOR J=1 TO ML
740 PRINT "LINHA ";J;" [";LB$(NE,J);"]: ";
750 LINE INPUT LT$
760 IF LT$<>"" THEN LB$(NE,J)=LEFT$(LT$,LW)
770 NEXT J
780 RETURN
790 REM
800 REM ===========================
810 REM    SUB: COPIAR
820 REM ===========================
830 CLS
840 PRINT "COPIAR ETIQUETA"
850 PRINT "Etiqueta ORIGEM (1-18): ";
860 INPUT NO
870 IF NO<1 OR NO>18 THEN RETURN
880 PRINT "Destino (ex: 2,3,5-8): ";
890 LINE INPUT DS$
900 GOSUB 1800
910 PRINT:PRINT "Copiado."
920 FOR W=1 TO 1000:NEXT W
930 RETURN
940 REM
950 REM
960 REM ===========================
970 REM    SUB: LIMPAR UMA
980 REM ===========================
990 CLS
1000 PRINT "LIMPAR ETIQUETA"
1010 PRINT "Numero (1-18): ";
1020 INPUT NE
1030 IF NE<1 OR NE>18 THEN RETURN
1040 FOR J=1 TO ML:LB$(NE,J)="":NEXT J
1050 PRINT "Etiqueta ";NE;" limpa."
1060 FOR W=1 TO 1000:NEXT W
1070 RETURN
1080 REM ===========================
1090 REM    SUB: LIMPAR TODAS
1100 REM ===========================
1110 CLS
1120 PRINT "LIMPAR TODAS? (S/N): ";
1130 A$=INPUT$(1):PRINT A$
1140 IF A$<>"S" AND A$<>"s" THEN RETURN
1150 FOR I=1 TO NT:FOR J=1 TO ML:LB$(I,J)="":NEXT J:NEXT I
1160 PRINT:PRINT "Todas limpas."
1170 FOR W=1 TO 1000:NEXT W
1180 RETURN
1190 REM
1200 REM ===========================
1210 REM    SUB: IMPRIMIR
1220 REM ===========================
1230 CLS
1240 PRINT "IMPRESSAO"
1250 PRINT
1260 PRINT "[1] IMPRIMIR TODAS"
1270 PRINT "[2] IMPRIMIR SELECAO"
1280 PRINT "[0] CANCELAR"
1290 PRINT "OPCAO: ";
1300 OP$=INPUT$(1):PRINT OP$
1310 IF OP$="0" THEN RETURN
1320 IF OP$="1" THEN FOR I=1 TO NT:PM$(I)="S":NEXT I
1330 IF OP$="2" THEN GOSUB 2000
1340 IF OP$<>"1" AND OP$<>"2" THEN GOTO 1290
1350 PRINT
1360 PRINT "Conecte a impressora."
1370 PRINT "Insira folha A4."
1380 PRINT "ENTER p/ imprimir...";
1390 LINE INPUT DM$
1400 REM === INIT EPSON LX-300 ===
1410 LPRINT CHR$(27);"@";CHR$(27);"P";CHR$(27);"2";
1420 REM === MARGEM SUPERIOR ===
1430 FOR LN=1 TO TM:LPRINT:NEXT LN
1440 REM === LOOP LINHAS DE ETIQUETAS ===
1450 FOR ROW=1 TO 6
1460 E1=(ROW-1)*3+1
1470 REM === LOOP LINHAS DE TEXTO ===
1480 FOR LN=1 TO LH
1490 TL=INT((LH-ML)/2)+1
1500 TX=LN-TL+1
1510 REM --- Imprime margem esq. sem CR/LF ---
1520 LPRINT SPACE$(CM);
1530 FOR COL=1 TO 3
1540 EI=E1+(COL-1)
1550 ET$=""
1552 IF TX>=1 AND TX<=ML THEN ET$=LB$(EI,TX)
1560 IF PM$(EI)="N" THEN ET$=""
1570 SL=LW-LEN(ET$)
1580 LP=INT(SL/2)
1590 RP=SL-LP
1600 ET$=SPACE$(LP)+ET$+SPACE$(RP)
1610 IF COL<3 THEN LPRINT ET$;SPACE$(GC);
1612 IF COL=3 THEN LPRINT ET$
1620 NEXT COL
1630 NEXT LN
1640 NEXT ROW
1650 LPRINT CHR$(12)
1660 PRINT:PRINT "Impressao concluida!"
1670 FOR W=1 TO 2000:NEXT W
1680 RETURN
1690 REM
1700 REM
1710 REM
1720 REM
1730 REM
1740 REM
1750 REM
1760 REM
1770 REM
1780 REM
1790 REM
1800 REM ===========================
1810 REM    SUB: PARSE COPIA
1820 REM === DS$=destinos NO=origem ===
1830 DS$=DS$+","
1840 ST=1
1850 TP=INSTR(ST,DS$,",")
1860 IF TP=0 THEN RETURN
1870 SG$=MID$(DS$,ST,TP-ST)
1880 ST=TP+1
1890 HR=INSTR(SG$,"-")
1900 IF HR=0 THEN NE=VAL(SG$):IF NE>=1 AND NE<=18 THEN FOR J=1 TO ML:LB$(NE,J)=LB$(NO,J):NEXT J
1910 IF HR>0 THEN NA=VAL(LEFT$(SG$,HR-1)):NB=VAL(MID$(SG$,HR+1))
1920 IF HR>0 AND NA<1 THEN NA=1
1930 IF HR>0 AND NB>18 THEN NB=18
1940 IF HR>0 THEN FOR NE=NA TO NB:FOR J=1 TO ML:LB$(NE,J)=LB$(NO,J):NEXT J:NEXT NE
1950 IF ST<=LEN(DS$) THEN GOTO 1850
1960 RETURN
1970 REM
1980 REM
1990 REM
2000 REM ===========================
2010 REM    SUB: SELECAO IMPRESSAO
2020 REM ===========================
2030 CLS
2040 PRINT "Etiquetas a imprimir:"
2050 PRINT "(ex: 1,3,5-10)"
2060 PRINT "ENTER = todas"
2070 LINE INPUT SS$
2080 IF SS$="" THEN FOR I=1 TO NT:PM$(I)="S":NEXT I:RETURN
2090 FOR I=1 TO NT:PM$(I)="N":NEXT I
2100 DS$=SS$+","
2110 ST=1
2120 TP=INSTR(ST,DS$,",")
2130 IF TP=0 THEN RETURN
2140 SG$=MID$(DS$,ST,TP-ST)
2150 ST=TP+1
2160 HR=INSTR(SG$,"-")
2170 IF HR=0 THEN NE=VAL(SG$):IF NE>=1 AND NE<=18 THEN PM$(NE)="S"
2180 IF HR>0 THEN NA=VAL(LEFT$(SG$,HR-1)):NB=VAL(MID$(SG$,HR+1))
2190 IF HR>0 AND NA<1 THEN NA=1
2200 IF HR>0 AND NB>18 THEN NB=18
2210 IF HR>0 THEN FOR NE=NA TO NB:PM$(NE)="S":NEXT NE
2220 IF ST<=LEN(DS$) THEN GOTO 2120
2230 RETURN
